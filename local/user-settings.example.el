;;; user-settings.example.el --- Machine-local configuration example -*- lexical-binding: t -*-

;; Copy this file to user-settings.el and set only values that differ per user
;; or machine.  user-settings.el is loaded before Spacemacs layers and ignored
;; by Git.

(setq personal-org-agenda-files nil)

;; Leave nil to discover `erl' from PATH.  Set this only for a non-standard
;; Erlang installation.
(setq my-erlang-root-path nil)

;;; user-settings.example.el ends here
